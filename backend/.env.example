# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Admin Owner Whitelist (Comma-separated emails allowed to access Admin Portal)
ADMIN_EMAILS=ramub9349@gmail.com

# Database Connection URI (MongoDB Atlas or Local)
MONGO_URI=mongodb://localhost:27017/dose-tracker

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_access_jwt_key_here
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
JWT_REFRESH_EXPIRE=7d

# Session, Cookie & CSRF Protection Secrets
COOKIE_SECRET=your_cookie_signing_secret_here
CSRF_SECRET=your_csrf_token_secret_here

# AI Service Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# SMTP Email Transporter Configuration (For Real Password Reset Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_email@gmail.com
SMTP_PASS=your_smtp_app_password
FROM_EMAIL=no-reply@dosetracker.com
FROM_NAME="DoseTracker AI Security"
FRONTEND_URL=http://localhost:3000
